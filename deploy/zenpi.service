[Unit]
Description=ZenPi Cockpit - Web Management Suite
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/zenpi/backend
ExecStart=/opt/zenpi/venv/bin/python -m uvicorn app.main:app --host 0.0.0.0 --port 8443
Restart=always
RestartSec=3
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
